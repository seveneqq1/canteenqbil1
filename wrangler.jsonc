{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canteenqbil1",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "canteenqbil1",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
